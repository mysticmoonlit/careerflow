# CareerFlow Environment Configuration Template
# Copy this file to .env for production deployment

# Django Secret Key (generate a secure random 50+ character string for production)
DJANGO_SECRET_KEY=your-production-django-secret-key-here

# Debug Mode (set to False in production)
DEBUG=True

# Comma-separated list of allowed hostnames/IPs
ALLOWED_HOSTS=localhost,127.0.0.1
