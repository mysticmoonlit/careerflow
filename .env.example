# ==========================================
# CareerFlow Backend Environment Configuration
# Copy this file to .env for production deployment
# DO NOT commit real secrets or production credentials
# ==========================================

# Django Secret Key (generate a random 50+ character string for production)
DJANGO_SECRET_KEY=your-secure-production-secret-key-change-me

# Debug Mode: Set to False in production
DJANGO_DEBUG=False

# Allowed Hostnames (comma-separated)
# In production on Render: .onrender.com,your-custom-domain.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# PostgreSQL Database Connection URL
# Local Development: Leave empty to automatically use SQLite (db.sqlite3)
# Render: Populated automatically from the attached PostgreSQL instance
DATABASE_URL=postgres://careerflow_user:password@hostname:5432/careerflow

# Frontend URL (your Vercel deployment URL)
FRONTEND_URL=https://your-careerflow.vercel.app

# Additional CORS Allowed Origins (comma-separated, optional)
CORS_ALLOWED_ORIGINS=https://your-careerflow.vercel.app

# Additional CSRF Trusted Origins (comma-separated, optional)
CSRF_TRUSTED_ORIGINS=https://your-careerflow.vercel.app,https://*.vercel.app
